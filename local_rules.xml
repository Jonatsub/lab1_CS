<group name="local,syslog,sshd,">

  <!-- Rule 100001: Single failed SSH password attempt -->
  <rule id="100001" level="8">
    <if_sid>5716</if_sid>
    <description>Lab1: Failed SSH password attempt detected.</description>
  </rule>

  <!-- Rule 100002: Multiple invalid user attempts from same source IP -->
  <rule id="100002" level="10" frequency="3" timeframe="120">
    <if_matched_sid>5710</if_matched_sid>
    <same_source_ip />
    <description>Lab1: Multiple invalid SSH user attempts from same source IP.</description>
  </rule>

  <!-- Rule 100003: Successful SSH login for root account -->
  <rule id="100003" level="9">
    <if_sid>5715</if_sid>
    <match>root</match>
    <description>Lab1: Successful SSH login for root account detected.</description>
  </rule>

</group>
